{
  "name": "nutrivida-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NutriVida Pro - plataforma SaaS modular de nutrição (esportiva, clínica/hospitalar, UAN, restaurantes, hotéis e resorts)",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply nutrivida --local",
    "db:migrate:remote": "wrangler d1 migrations apply nutrivida --remote",
    "e2e": "npm run build && playwright test",
    "seed": "node --experimental-strip-types scripts/seed-demo.ts"
  },
  "dependencies": {
    "hono": "^4",
    "pdf-lib": "^1.17.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^4",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "4.1.0",
    "wrangler": "^4"
  }
}
